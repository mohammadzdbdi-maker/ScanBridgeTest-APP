                                            Style="{StaticResource RoundedButtonStyle}"
                                            Background="#F57F17"
                                            Padding="10,8"
                                            FontSize="13"
                                            Height="38" />
                                </Grid>
                            </Border>

                            <!-- TtTeck (فشرده) -->
