                                    <CheckBox x:Name="TtTeckEnabledCheckBox"
                                              Grid.Row="1"
                                              FontSize="12"
                                              Foreground="#333333"
                                              Checked="TtTeckEnabledCheckBox_Checked"
                                              Unchecked="TtTeckEnabledCheckBox_Unchecked">
                                        <TextBlock x:Name="TtTeckEnableText"
                                                   Text="فعال‌سازی جستجوی خودکار تی‌تک"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                </Grid>
                            </Border>

                            <!-- Device Reconnect (فشرده) -->
                            <Border Grid.Column="4"
                                    Background="#F0FDF4"
                                    CornerRadius="14"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
