                            CornerRadius="36"
                            Background="#ECFDF5"
                            Margin="0,0,0,18">
                        <TextBlock x:Name="StyledMessageIcon"
                                   Text="✓"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="StyledMessageTitle"
                               Text="ثبت شد"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1A237E"
                               TextAlignment="Center"
                               Margin="0,0,0,12" />

                    <Border x:Name="StyledMessageProductPhotoBorder"
                            Background="White"
                            CornerRadius="16"
                            Padding="14"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Width="200"
                            Height="200"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">
                        <Image x:Name="StyledMessageProductPhoto" Stretch="Uniform" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="500"
                                  Margin="0,0,0,26">
                        <TextBlock x:Name="StyledMessageText"
                                   Text="تنظیمات با موفقیت ذخیره شدند"
                                   FontSize="15"
                                   Foreground="#4B5563"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- لیست داروخانه‌ها برای تعویض سریع -->
                    <Border x:Name="StyledMessagePharmacyListBorder"
                            Background="#F0F4FF"
                            CornerRadius="12"
                            Padding="12"
                            Visibility="Collapsed"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="StyledMessagePharmacyListTitle"
                                       Text=""
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1A237E"
                                       TextAlignment="Center"
                                       Margin="0,0,0,10" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="300">
                                <StackPanel x:Name="StyledMessagePharmacyListPanel" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StyledMessageLinkButton"
                                Content="باز کردن لینک"
                                Click="StyledMessageLinkButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#1565C0"
                                Padding="24,12"
                                FontSize="15"
                                Width="150"
                                Height="48"
                                Margin="0,0,10,0"
                                Visibility="Collapsed" />
                        <Button x:Name="StyledMessageRepeatFormulaButton"
                                Content="ثبت مجدد"
                                Click="StyledMessageRepeatFormulaButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#7C3AED"
                                Padding="24,12"
                                FontSize="15"
                                Width="150"
                                Height="48"
                                Margin="0,0,10,0"
                                Visibility="Collapsed" />
                        <Button x:Name="StyledMessageRetryButton"
                                Content="تلاش مجدد"
                                Click="StyledMessageRetryButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#D97706"
                                Padding="24,12"
                                FontSize="15"
                                Width="150"
                                Height="48"
                                Margin="0,0,10,0"
                                Visibility="Collapsed" />
                        <Button x:Name="StyledMessageOkButton"
                                Content="باشه"
                                IsDefault="True"
                                Click="StyledMessageOkButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#10B981"
                                Padding="24,12"
                                FontSize="15"
                                Width="150"
                                Height="48" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
