                        <Button x:Name="LicenseImportFileButton" Content="ورود فایل" Visibility="Collapsed" Click="LicenseImportFileButton_Click" Style="{StaticResource RoundedButtonStyle}" Background="#1565C0" Width="120" Height="42" Margin="6,0" />
                        <Button x:Name="LicenseExportFileButton" Content="خروجی شناسه" Visibility="Collapsed" Click="LicenseExportFileButton_Click" Style="{StaticResource RoundedButtonStyle}" Background="#F59E0B" Width="130" Height="42" Margin="6,0" />
                        <Button x:Name="CloseLicenseOverlayButton" Content="بستن" Click="CloseLicenseOverlay_Click" Style="{StaticResource RoundedButtonStyle}" Background="#9CA3AF" Width="100" Height="42" Margin="6,0" />
