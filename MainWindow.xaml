        <!-- Settings -->
        <Grid x:Name="TtTeckSettingsOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              MouseDown="TtTeckSettingsOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="24"
                    Padding="32"
                    Width="960"
                    MaxHeight="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="TtTeckSettingsCard_MouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TtTeckSettingsTitle"
                                   Text="تنظیمات"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,24"
                                   TextAlignment="Center" />

                        <!-- ردیف اول: زبان، تی‌تک، اتصال مجدد دستگاه‌ها - سه ستون فشرده -->
