                            <Border Grid.Column="0"
                                    Background="#F0F7FF"
                                    CornerRadius="14"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock x:Name="LanguageCardTitle"
                                                   Text="🌐 زبان"
