                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- وضعیت: در حال جست‌وجو / خطا -->
                            <TextBlock x:Name="PriceLookupStatusText"
