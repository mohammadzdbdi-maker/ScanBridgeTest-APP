                                            Style="{StaticResource RoundedButtonStyle}"
                                            Background="#6366F1"
                                            Padding="10,8"
                                            FontSize="13"
                                            Height="38" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- رفع تداخل اینترنت در اتصال USB (اینترنت جانبی) -->
                        <Border Background="#FFF7ED"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
