        <!-- Messages Overlay -->
        <Grid x:Name="MessagesOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              MouseDown="MessagesOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="24"
                    Padding="28"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="MessagesCard_MouseDown">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="MessagesHeaderText"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="✕"
                                Click="CloseMessagesButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#F3F4F6"
                                Foreground="#374151"
                                Width="32"
                                Height="32"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBackground}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"
                                                       FontSize="15"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />

                                            <!-- دکمه‌ی «باشه» - جایگزین چک‌باکس قبلی «خوانده شد» طبق درخواست
                                                 کاربر: پیام را خوانده‌شده علامت می‌زند و با یک محوشدنِ نرم
                                                 (fade-out) کاملاً از لیست حذف می‌کند (نگاه کنید به
                                                 MessageAcknowledgeButton_Click در code-behind). -->
                                            <Button Grid.Column="1"
                                                    Content="باشه"
                                                    Click="MessageAcknowledgeButton_Click"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="#ECFDF5"
                                                    Foreground="#10B981"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0" />

                                            <!-- دکمه‌ی «حذف» - طبق درخواست کاربر، کنار دکمه‌ی «باشه» - پیام را
                                                 فوراً (بدون fade) از لیست و از notifications.json پاک می‌کند
                                                 (نگاه کنید به MessageDeleteButton_Click در code-behind). -->
                                            <Button Grid.Column="2"
                                                    Content="حذف"
                                                    Click="MessageDeleteButton_Click"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="#FEE2E2"
                                                    Foreground="#DC2626"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0" />
                                        </Grid>

                                        <TextBlock Text="{Binding Body}"
                                                   Foreground="#4B5563"
                                                   FontSize="14"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />

                                        <Button Content="{Binding LinkButtonText}"
                                                Visibility="{Binding HasLinkVisibility}"
                                                Click="MessageLink_Click"
                                                Tag="{Binding Link}"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Background="#1565C0"
                                                HorizontalAlignment="Right"
                                                Padding="12,6"
                                                Margin="0,8,0,0"
                                                FontSize="13" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoMessagesText"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

