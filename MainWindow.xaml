<Window x:Class="ScanBridgeTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Scanbridge"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Closing="MainWindow_OnClosing"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedInputStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContentGrid">

        <!-- Main Content -->
        <Grid x:Name="MainContent" Background="#F8F9FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Margin="24,24,24,16"
                    Background="White"
                    CornerRadius="24"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo / Title -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,12,0">
                            <Rectangle Width="6" Height="28" Fill="#1A237E" Margin="0,0,2,0" />
                            <Rectangle Width="6" Height="28" Fill="#1565C0" Margin="0,0,2,0" />
                            <Rectangle Width="6" Height="28" Fill="#F57F17" Margin="0,0,2,0" />
                        </StackPanel>

                        <TextBlock x:Name="AppTitleText"
                                   Text="Scanbridge"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#1A237E" />
                    </StackPanel>

                    <!-- Messages + Settings -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Messages -->
                        <Grid Margin="0,0,14,0">
                            <Button x:Name="MessagesButton"
                                    Click="MessagesButton_Click"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="#1565C0"
                                    FontSize="14"
                                    Padding="16,10"
                                    Height="48"
                                    MinWidth="90">
                                <TextBlock x:Name="MessagesButtonText"
                                           Text="پیام‌ها" />
                            </Button>

                            <!-- شمارنده‌ی پیام‌های خوانده‌نشده - هم‌استایل با CargoDeliveryAlertBadge (نشان‌گر
                                 «تاریخ نزدیک») طبق درخواست کاربر؛ تا وقتی هر پیام با چک‌باکس «خوانده شد»
                                 علامت نخورد اینجا شمرده می‌شود (نگاه کنید به UpdateMessagesBadgeCount). -->
                            <Border x:Name="MessagesBadge"
                                    Visibility="Collapsed"
                                    Background="#DC2626"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    MinWidth="20"
                                    Height="20"
                                    Padding="4,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="-8,-8,0,0"
                                    Panel.ZIndex="10"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="MessagesBadgeText"
                                           Text="1"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Support -->
                        <Button x:Name="SupportButton"
                                Click="SupportButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#0D47A1"
                                FontSize="14"
                                Padding="16,10"
                                Height="48"
                                MinWidth="64"
                                Margin="0,0,14,0"
                                ToolTip="پشتیبانی">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📞"
                                           FontSize="16"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="پشتیبانی"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- License -->
                        <Button x:Name="LicenseButton"
                                Click="LicenseButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#F59E0B"
                                FontSize="14"
                                Padding="16,10"
                                Height="48"
                                MinWidth="64"
                                Margin="0,0,14,0"
                                ToolTip="لایسنس">
                            <TextBlock Text="🔑"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!-- Settings -->
                        <Button x:Name="SettingsButton"
                                Click="SettingsButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#6B7280"
                                FontSize="14"
                                Padding="16,10"
                                Height="48"
                                MinWidth="105">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️"
                                           FontSize="16"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsButtonText"
                                           Text="تنظیمات"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Area -->
            <Grid Grid.Row="1"
                  Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- QR -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="24"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   x:Name="BarcodeTitle"
                                   Text="جهت اتصال بارکد زیر را روی گوشی اسکن کنید"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   TextAlignment="Center"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap" />

                        <Border Grid.Row="1"
                                BorderBrush="#E5E7EB"
                                BorderThickness="2"
                                CornerRadius="12"
                                Background="#F9FAFB"
                                Padding="8">
                            <Image x:Name="QrImage"
                                   Stretch="Uniform"
                                   Margin="4" />
                        </Border>

                        <Button Grid.Row="2"
                                x:Name="PrintQrButton"
                                Click="PrintQrButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="48"
                                Margin="0,12,0,0"
                                Background="#FF5722"
                                FontSize="16"
                                Content="🖨️ چاپ" />

                    </Grid>
                </Border>

                <!-- Connected Devices -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="24"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   x:Name="ConnectedDevicesTitle"
                                   Text="دستگاه های متصل"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#F57F17"
                                   Margin="0,0,0,12" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="DevicesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB"
                                                    CornerRadius="12"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8"
                                                    Cursor="Hand"
                                                    Tag="{Binding OriginalDeviceName}"
                                                    MouseDown="DeviceRow_MouseDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0"
                                                             Width="12"
                                                             Height="12"
                                                             Fill="{Binding StatusColor}"
                                                             Margin="0,0,10,0"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DeviceName}"
                                                               FontSize="16"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="2"
                                                            Background="#EFF6FF"
                                                            CornerRadius="8"
                                                            Padding="8,3"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LinkBadge}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#1E3A8A" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3"
                                                               Text="✎"
                                                               FontSize="14"
                                                               Foreground="#7C3AED"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="4"
                                                            Content="✕"
                                                            Click="DisconnectDeviceButton_Click"
                                                            Tag="{Binding OriginalDeviceName}"
                                                            Style="{StaticResource RoundedButtonStyle}"
                                                            Background="#E53935"
                                                            Foreground="White"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0"
                                                            FontSize="11"
                                                            Margin="8,0,0,0"
                                                            ToolTip="قطع اتصال" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoDevicesText"
                                           Text="هیچ دستگاهی متصل نیست"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Margin="0,20,0,0" />

                                <!-- System Info -->
                                <Border Background="#F9FAFB"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SystemInfoTitle"
                                                   Text="اطلاعات سیستم"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#F57F17"
                                                   Margin="0,0,0,10" />

                                        <TextBlock x:Name="ComputerNameText"
                                                   FontSize="14"
                                                   Foreground="#666666"
                                                   Margin="0,4" />

                                        <TextBlock x:Name="LanIpText"
                                                   FontSize="14"
                                                   Foreground="#666666"
                                                   Margin="0,4" />

                                        <TextBlock x:Name="PortText"
                                                   FontSize="14"
                                                   Foreground="#666666"
                                                   Margin="0,4" />

                                        <Border x:Name="TtacConnectionStatusPanel"
                                                Background="#F3F4F6"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="10"
                                                Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TtacConnectionStatusIcon"
                                                           Grid.Column="0"
                                                           Text="●"
                                                           Foreground="#9CA3AF"
                                                           FontSize="18"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TtacConnectionStatusTitle"
                                                               Text="وضعیت اتصال تی‌تک"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="#374151" />
                                                    <TextBlock x:Name="TtacConnectionStatusText"
                                                               Text="متصل نیست"
                                                               FontSize="12"
                                                               Foreground="#6B7280"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button x:Name="TtacOpenSiteButton"
                                                        Grid.Column="2"
                                                        Content="ورود به سایت تی‌تک"
                                                        Click="TtacOpenSiteButton_Click"
                                                        Style="{StaticResource RoundedButtonStyle}"
                                                        Background="#1565C0"
                                                        MinWidth="132"
                                                        Height="34"
                                                        Padding="10,0"
                                                        FontSize="12"
                                                        Margin="8,0,0,0"
                                                        ToolTip="باز کردن سایت تی‌تک" />
                                                <Button x:Name="TtacDisconnectButton"
                                                        Grid.Column="3"
                                                        Content="⏻"
                                                        Click="TtacDisconnectButton_Click"
                                                        Style="{StaticResource RoundedButtonStyle}"
                                                        Background="#E53935"
                                                        Width="34"
                                                        Height="34"
                                                        Padding="0"
                                                        FontSize="15"
                                                        Margin="8,0,0,0"
                                                        ToolTip="قطع اتصال تی‌تک"
                                                        Visibility="Collapsed" />
                                            </Grid>
                                        </Border>

                                        <!-- فعال‌سازی بانک بارکد پرمصرف (آیکون شناور) - فقط پلن تی‌تک‌پلاس، نمایش/عدم‌نمایش با پلن در ApplyLicenseToUi -->
                                        <CheckBox x:Name="HighUsageWidgetEnableCheckBox"
                                                  FontSize="13"
                                                  Foreground="#333333"
                                                  Margin="0,14,0,0"
                                                  Visibility="Collapsed"
                                                  Checked="HighUsageWidgetEnableCheckBox_Checked"
                                                  Unchecked="HighUsageWidgetEnableCheckBox_Unchecked">
                                            <TextBlock x:Name="HighUsageWidgetEnableText"
                                                       Text="📦 فعال‌سازی بانک بارکد پرمصرف"
                                                       TextWrapping="Wrap" />
                                        </CheckBox>

                                        <CheckBox x:Name="StartupOnWindowsBootCheckBox"
                                                  FontSize="13"
                                                  Foreground="#333333"
                                                  Margin="0,16,0,0"
                                                  Checked="StartupOnWindowsBootCheckBox_Checked"
                                                  Unchecked="StartupOnWindowsBootCheckBox_Unchecked" 
                                                  Visibility="Collapsed" />

                                        <Button x:Name="AllowDeviceReconnectMainButton"
                                                Content="فعال‌سازی اتصال مجدد گوشی‌ها"
                                                Click="AllowDeviceReconnectButton_Click"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Background="#10B981"
                                                Padding="12,8"
                                                FontSize="13"
                                                Height="40"
                                                Margin="0,12,0,0"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- User Panel -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="24"
                        Padding="20"
                        VerticalAlignment="Stretch">
                    <ScrollViewer x:Name="UserPanelScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="UserPanelButtonsStack">
                            <TextBlock x:Name="UserPanelTitle"
                                   Text="پنل کاربری"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#F57F17"
                                   Margin="0,0,0,20" />

                        <Button x:Name="HistoryButton"
                                Click="HistoryButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="60"
                                Margin="0,8"
                                Background="#F57F17"
                                FontSize="18"
                                Content="تاریخچه" />

                        <Button x:Name="TtacPanelButton"
                                Click="TtacPanelButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="60"
                                Margin="0,8"
                                Background="#7C3AED"
                                FontSize="18"
                                Content="تی‌تک" />

                        <Button x:Name="CargoDeliveryPanelButton"
                                Click="CargoDeliveryPanelButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="60"
                                Margin="0,8"
                                Background="#10B981"
                                FontSize="18"
                                Content="تحویل بار" />

                        <Button x:Name="HighUsageBarcodePanelButton"
                                Click="HighUsageBarcodePanelButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="60"
                                Margin="0,8"
                                Background="#EA580C"
                                FontSize="18"
                                Content="بارکد پرمصرف" />

                        <Grid x:Name="ExpiryWatchPanelButtonHost"
                              Margin="0,8"
                              Visibility="Collapsed">
                            <Button x:Name="ExpiryWatchPanelButton"
                                    Click="ExpiryWatchPanelButton_Click"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Height="60"
                                    Background="#F57F17"
                                    FontSize="18"
                                    Content="تاریخ نزدیک" />
                            <Border x:Name="CargoDeliveryAlertBadge"
                                    Visibility="Collapsed"
                                    Background="#DC2626"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="9"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,5,5,0"
                                    Panel.ZIndex="10"
                                    IsHitTestVisible="False">
                                <TextBlock Text="!"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- استعلام قیمت فرآورده — زیر دکمه‌ی «تاریخ نزدیک» در پنل کاربری -->
                        <Button x:Name="PriceLookupPanelButton"
                                Click="PriceLookupPanelButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="60"
                                Margin="0,8"
                                Background="#F59E0B"
                                FontSize="18"
                                Content="💰 استعلام قیمت" />

                        <!-- باکس پیشرفت دانلود بروزرسانی - قبلاً یک پنجره‌ی جدا (DownloadProgressWindow) بود
                             که موقعیتش با محاسبه‌ی دستی Left/Top هیچ‌وقت درست از آب در نمی‌آمد (کاربر چند بار
                             گزارش داد «میره پایین»). به‌جایش این یک Border معمولی است، درست به‌عنوان فرزند
                             بعدیِ همین ستون دکمه‌ها - بلافاصله بعد از «تاریخ نزدیک» - پس همیشه دقیقاً زیرش
                             می‌ماند، چون چیدمان طبیعی WPF این را تضمین می‌کند، نه هیچ محاسبه‌ای. نگاه کنید به
                             ShowDownloadProgressPanel / UpdateDownloadProgressPanel / HideDownloadProgressPanel
                             در MainWindow.xaml.cs. -->
                        <Border x:Name="DownloadProgressPanel"
                                Background="White"
                                CornerRadius="16"
                                Margin="0,8"
                                Padding="14"
                                Visibility="Collapsed"
                                BorderBrush="#93C5FD"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DownloadProgressTitleText"
                                               Grid.Column="0"
                                               Text="⬇ دانلود بروزرسانی"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#1A237E"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="DownloadProgressCancelButton"
                                            Grid.Column="1"
                                            Content="✕"
                                            Click="DownloadProgressCancelButton_Click"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Background="#F3F4F6"
                                            Foreground="#6B7280"
                                            Width="26"
                                            Height="26"
                                            Padding="0"
                                            FontSize="11"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <ProgressBar x:Name="DownloadProgressBar"
                                             Height="10"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             IsIndeterminate="True"
                                             Foreground="#1565C0"
                                             Background="#E5E7EB"
                                             BorderThickness="0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DownloadProgressSizeText"
                                               Grid.Column="0"
                                               Text=""
                                               FontSize="11"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="DownloadProgressPercentText"
                                               Grid.Column="1"
                                               Text="در حال شروع..."
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#1565C0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ReceiveStatusPanelButton"
                                Click="ReceiveStatusPanelButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Height="60"
                                Margin="0,8"
                                Background="#0891B2"
                                FontSize="18"
                                Content="تعیین وضعیت"
                                Visibility="Collapsed" />

                        <Border x:Name="SupportPanel"
                                Background="#F9FAFB"
                                CornerRadius="16"
                                Margin="0,8"
                                Padding="14"
                                Visibility="Collapsed"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="SupportMessageText"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="#333333"
                                           Margin="0,0,0,8" />

                                <Button x:Name="WhatsAppButton"
                                        Click="WhatsAppButton_Click"
                                        Style="{StaticResource RoundedButtonStyle}"
                                        Content="09136346309"
                                        Background="#25D366"
                                        FontSize="16"
                                        Height="42" />

                                <Button x:Name="SupportSiteButton"
                                        Click="SupportSiteButton_Click"
                                        Style="{StaticResource RoundedButtonStyle}"
                                        Content="سایت خرید و تمدید"
                                        Background="#1565C0"
                                        FontSize="15"
                                        Height="42"
                                        Margin="0,8,0,0" />

                                <Button x:Name="RemoteSupportButton"
                                        Click="RemoteSupportButton_Click"
                                        Style="{StaticResource RoundedButtonStyle}"
                                        Content="اتصال پشتیبانی از راه دور"
