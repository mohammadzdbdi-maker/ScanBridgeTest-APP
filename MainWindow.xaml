                                                   FontSize="11"
                                                   Foreground="#4B5563"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />
                                    </StackPanel>
                                    <Button x:Name="AllowDeviceReconnectButton"
                                            Grid.Row="1"
                                            Content="فعال‌سازی اتصال مجدد"
                                            Click="AllowDeviceReconnectButton_Click"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Background="#10B981"
                                            Padding="10,8"
                                            FontSize="13"
                                            Height="38" />
                                </Grid>
                            </Border>

