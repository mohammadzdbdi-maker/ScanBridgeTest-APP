                                    <StackPanel>
                                        <TextBlock Text="نام فارسی" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,2" />
                                        <TextBlock x:Name="PriceLookupFaNameText" Text="-" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="2,0,0,8" />
                                        <TextBlock Text="نام انگلیسی" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,2" />
                                        <TextBlock x:Name="PriceLookupEnNameText" Text="-" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap" Margin="2,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="کد ژنریک" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,2" />
                                                <TextBlock x:Name="PriceLookupGenericCodeText" Text="-" FontSize="14" Foreground="#0F172A" FlowDirection="LeftToRight" Margin="2,0,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="تعداد در بسته" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,2" />
                                                <TextBlock x:Name="PriceLookupPackageCountText" Text="-" FontSize="14" Foreground="#0F172A" FlowDirection="LeftToRight" Margin="2,0,0,8" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="نام فارسی مالک برند" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,2" />
                                        <TextBlock x:Name="PriceLookupBrandOwnerText" Text="-" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap" Margin="2,0,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- قیمت نهایی: بزرگ، سبز، ریال، سه‌رقم جدا -->
                                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="قیمت مصرف‌کننده (کل بسته)" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PriceLookupPriceText"
                                                   Text="-"
                                                   FontSize="30"
                                                   FontWeight="ExtraBold"
                                                   Foreground="#16A34A"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="ریال" FontSize="13" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- هشدار: فرآورده در زیرگروه دارویی نیست -->
                                <Border x:Name="PriceLookupNotDrugWarning"
                                        Background="#FEF2F2"
                                        BorderBrush="#FCA5A5"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12"
                                        Visibility="Collapsed">
                                    <TextBlock Text="⚠️ این محصول در زیرگروه دارویی نیست و قیمت رسمی ندارد؛ برای استعلام قیمت به سایت‌های معتبر یا فاکتور دارویی استناد کنید."
                                               FontSize="13"
                                               Foreground="#B91C1C"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

