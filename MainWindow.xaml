                                Background="#ECFDF5"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ExpiryAlertSectionTitle"
                                           Text="📅 هشدار تاریخ انقضای نزدیک"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#047857"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="ExpiryAlertSectionDescription"
                                           Text="مخصوص پلن تی‌تک پلاس - وقتی کالایی در «تحویل بار» با تاریخ انقضای نزدیک ثبت شود، در همان پنل هشدار داده می‌شود."
                                           FontSize="12"
                                           Foreground="#4B5563"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock x:Name="ExpiryThresholdMonthsLabel"
                                                   Text="چند ماه قبل از انقضا هشدار بدهد؟"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBox x:Name="ExpiryThresholdMonthsTextBox"
                                                 Style="{StaticResource RoundedInputStyle}"
                                                 Height="40"
                                                 FontSize="14"
                                                 Padding="10,6"
                                                 TextAlignment="Center"
                                                 FlowDirection="LeftToRight" />

                                        <TextBlock x:Name="RepeatReminderDaysLabel"
                                                   Text="دوباره هر چند روز یادآوری کند؟"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap"
