                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="HistoryDateFilterLabel"
                                           Text="فیلتر تاریخ و ساعت"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#4B5563"
                                           Margin="0,0,0,6" />
                                <Button x:Name="HistoryDateRangeButton"
                                        Content="انتخاب بازه تاریخ و ساعت"
                                        Click="HistoryDateRangeButton_Click"
                                        Style="{StaticResource RoundedButtonStyle}"
                                        Background="#1565C0"
                                        Height="38"
                                        FontSize="13"
                                        Padding="10,6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Export Success -->
                    <Grid x:Name="SuccessMessageGrid"
                          Grid.Row="2"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="SuccessIcon"
                                       Text="✓"
                                       FontSize="60"
                                       Foreground="#4CAF50"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16" />

                            <TextBlock x:Name="SuccessTitle"
                                       Text="صادر کردن موفق!"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1A237E"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"
                                       TextAlignment="Center" />

                            <TextBlock x:Name="SuccessMessage"
                                       Text="تاریخچه با موفقیت به Excel صادر شد"
                                       FontSize="16"
                                       Foreground="#4B5563"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"
                                       TextAlignment="Center" />

                            <TextBlock x:Name="SuccessFilePath"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- History List -->
                    <ListBox Grid.Row="2"
                             x:Name="HistoryListBox"
                             MouseDoubleClick="HistoryListBox_MouseDoubleClick"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal">
                                            <Border Background="#EEF2FF"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding RowNumber}"
                                                           Foreground="#1A237E"
                                                           FontSize="13"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding Barcode}"
                                                       Foreground="#111827"
                                                       FontSize="17"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Text="{Binding TimeText}"
                                                       Foreground="#6B7280"
                                                       FontSize="14"
                                                       Margin="14,0,0,0" />

                                            <TextBlock Text="{Binding PersianDateText}"
                                                       Foreground="#9CA3AF"
                                                       FontSize="13"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DeviceName}"
                                                   Foreground="#666666"
                                                   FontSize="14"
                                                   Margin="20,0,0,0" />

                                        <Button Grid.Column="2"
                                                Content="کپی"
                                                Click="HistoryCopyButton_Click"
                                                Tag="{Binding Barcode}"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Background="#F57F17"
                                                FontSize="12"
                                                Padding="12,6"
                                                Margin="20,0,0,0" />

                                        <Button Grid.Column="3"
                                                Content="{Binding DataContext.DeleteButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Click="DeleteHistoryItemButton_Click"
                                                Tag="{Binding Record}"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Background="#E53935"
                                                FontSize="12"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- TtTeck Filtered History List -->
                    <ListBox Grid.Row="2"
                             x:Name="TtTeckHistoryListBox"
                             MouseDoubleClick="TtTeckHistoryListBox_MouseDoubleClick"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="Collapsed"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- نام محصول فضای آزاد را می‌گیرد و در صورت طولانی بودن کوتاه می‌شود -->
                                            <ColumnDefinition Width="*" />
                                            <!-- ساعت و تاریخ ثابت می‌مانند -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- همه دکمه‌ها داخل یک ستون هستند تا روی هم نیفتند -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#EEF2FF"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding RowNumber}"
                                                           Foreground="#1A237E"
                                                           FontSize="13"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding ProductDisplayName}"
                                                       ToolTip="{Binding ProductDisplayName}"
                                                       Foreground="#111827"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="14,0,14,0">
                                            <TextBlock Text="{Binding TimeText}"
                                                       Foreground="#6B7280"
                                                       FontSize="14"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />

                                            <TextBlock Text="{Binding PersianDateText}"
                                                       Foreground="#9CA3AF"
                                                       FontSize="13"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
<Button Content="قیمت"
                                                    Click="TtTeckHistoryPriceButton_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="#F59E0B"
                                                    FontSize="12"
                                                    Padding="12,6"
                                                    Width="62"
                                                    Height="34"
                                                    Margin="0,0,8,0" />

                                                                                        <Button Content="{Binding RegistrationButtonText}"
                                                    Click="OpenTtTeckRegistrationButton_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="{Binding RegistrationButtonBackground}"
                                                    FontSize="12"
                                                    Padding="12,6"
                                                    Width="105"
                                                    Height="34"
                                                    Margin="0,0,8,0" />

                                            <Button Content="{Binding DataContext.RetryLookupButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="RetryTtTeckLookupButton_Click"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding RetryButtonVisibility}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="#10B981"
                                                    FontSize="12"
                                                    Padding="12,6"
                                                    Width="110"
                                                    Height="34"
                                                    Margin="0,0,8,0" />

                                            <Button Content="کپی"
                                                    Click="HistoryCopyButton_Click"
                                                    Tag="{Binding Barcode}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="#7C3AED"
                                                    FontSize="12"
                                                    Padding="12,6"
                                                    Width="64"
                                                    Height="34"
                                                    Margin="0,0,8,0" />

                                            <Button Content="{Binding DataContext.DeleteButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="DeleteHistoryItemButton_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="#E53935"
                                                    FontSize="12"
                                                    Padding="12,6"
                                                    Width="64"
                                                    Height="34" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Ttac Direct Login -->
        <Grid x:Name="TtacLoginOverlay"
              Panel.ZIndex="100"
              Background="#80000000"
              Visibility="Collapsed"
              MouseDown="TtacLoginOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="24"
                    Padding="30"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="TtacLoginCard_MouseDown">
                <StackPanel>
                    <TextBlock x:Name="TtacLoginTitle"
                               Text="ورود به تی‌تک"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1A237E"
                               TextAlignment="Center"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="TtacLoginDescription"
                               Text="نشست تی‌تک منقضی شده یا هنوز وارد نشده‌اید. برای ورود از مرورگر داخلی استفاده کنید."
                               FontSize="13"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,18" />

                    <TextBlock x:Name="TtacLoginUsernameLabel"
                               Text="نام کاربری"
                               FontWeight="Bold"
                               Foreground="#4B5563"
                               Margin="0,0,0,6"
                               Visibility="Collapsed" />
                    <TextBox x:Name="TtacLoginUsernameTextBox"
                             Height="40"
                             FontSize="14"
                             Padding="10,7"
                             Margin="0,0,0,4"
                             TextChanged="TtacLoginUsernameTextBox_TextChanged"
                             Visibility="Collapsed" />
                    <TextBlock x:Name="TtacLoginUsernameHintText"
                               Text=""
                               FontSize="12"
                               Foreground="#1565C0"
                               TextWrapping="Wrap"
                               Margin="2,0,0,10"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="TtacLoginPasswordLabel"
                               Text="رمز عبور"
                               FontWeight="Bold"
                               Foreground="#4B5563"
                               Margin="0,0,0,6"
                               Visibility="Collapsed" />
                    <PasswordBox x:Name="TtacLoginPasswordBox"
                                 Height="40"
                                 FontSize="14"
                                 Padding="10,7"
                                 Margin="0,0,0,12"
                                 Visibility="Collapsed" />

                    <CheckBox x:Name="TtacLoginRememberCheckBox"
                              Content="ذخیره امن نام کاربری و رمز روی همین ویندوز (برای ورود سریع بعدی)"
                              FontSize="13"
                              Foreground="#4B5563"
                              Margin="0,0,0,12"
                              Visibility="Collapsed" />

                    <TextBlock x:Name="TtacLoginStatusText"
                               Text=""
                               FontSize="13"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="TtacLoginSubmitButton"
                                Content="ورود"
                                Click="TtacLoginSubmitButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#10B981"
                                Width="130"
                                Height="46"
                                Margin="8,0"
                                Visibility="Collapsed" />
                        <Button x:Name="TtacLoginOpenBrowserButton"
                                Content="ورود با مرورگر داخلی"
                                Click="TtacLoginOpenBrowserButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#1565C0"
                                Width="170"
                                Height="46"
                                Margin="8,0" />
                        <Button x:Name="TtacLoginCancelButton"
                                Content="انصراف"
                                Click="TtacLoginCancelButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#9CA3AF"
                                Width="130"
                                Height="46"
                                Margin="8,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TtTeck Registration Phase 1 -->
        <Grid x:Name="TtTeckRegistrationOverlay"
              Panel.ZIndex="90"
              Background="#80000000"
              Visibility="Collapsed"
              MouseDown="TtTeckRegistrationOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="24"
                    Padding="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="24"
                    MouseDown="TtTeckRegistrationCard_MouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TtTeckRegistrationTitle"
                                       Text="ثبت در سامانه تی‌تک"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#1A237E"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Click="TtTeckRegistrationCloseButton_Click"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="#F3F4F6"
                                    Foreground="#374151"
                                    Width="36"
                                    Height="36"
                                    Padding="0" />
                        </Grid>


                                                <Grid x:Name="TtTeckRegistrationColumnsGrid" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: captcha, messages, logs -->
                            <Border x:Name="TtTeckRegistrationCaptchaColumn"
                                    Grid.Column="0"
                                    Background="#FFFBEB"
                                    CornerRadius="18"
                                    Padding="16"
                                    BorderBrush="#FCD34D"
                                    BorderThickness="1"
                                    Margin="0,0,12,0"
                                    FlowDirection="RightToLeft">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               x:Name="TtTeckRegistrationPhaseNote"
                                               Text="متن ریز تصویر را در کادر زیر وارد کنید."
                                               TextWrapping="Wrap"
                                               Foreground="#92400E"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"
                                               TextAlignment="Center" />
                                    <Border Grid.Row="1"
                                            Width="220"
                                            Height="70"
                                            HorizontalAlignment="Center"
                                            Background="White"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="0,0,0,10">
                                        <Image x:Name="TtTeckRegistrationCaptchaImage" Stretch="Uniform" />
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TtTeckRegistrationCaptchaTextBox"
                                                 Style="{StaticResource RoundedInputStyle}"
                                                 Grid.Column="0"
                                                 Height="42"
                                                 FontSize="16"
                                                 Padding="10,7"
                                                 TextAlignment="Center"
                                                 TextChanged="TtacRegistrationField_TextChanged"
                                                 KeyDown="TtTeckRegistrationCaptchaTextBox_KeyDown" />
                                        <Button x:Name="TtTeckRegistrationGetCaptchaButton"
                                                Grid.Column="1"
                                                Content="بازنشانی"
                                                Click="TtTeckRegistrationGetCaptchaButton_Click"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Background="#F57F17"
                                                Height="42"
                                                Margin="10,0,0,0" />
                                    </Grid>
                                    <StackPanel Grid.Row="3">
                                        <TextBlock x:Name="TtTeckRegistrationResultText" Text="" TextWrapping="Wrap" Foreground="#1A237E" FontSize="13" Margin="0,0,0,8" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                            <ItemsControl x:Name="TtTeckRegistrationLogsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{Binding StatusBrush}" FontSize="13" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Message}" Foreground="#4B5563" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Middle: inputs -->
                            <Border x:Name="TtTeckRegistrationInputsColumn"
                                    Grid.Column="1"
                                    Background="#F9FAFB"
                                    CornerRadius="18"
                                    Padding="16"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Margin="0,0,12,0"
                                    FlowDirection="RightToLeft">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TtTeckRegistrationTypeLabel" Text="نوع ثبت" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,6" TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Button x:Name="TtTeckRegistrationNonePrescriptionButton" Content="فاقد نسخه" Click="TtTeckRegistrationNonePrescriptionButton_Click" Style="{StaticResource RoundedButtonStyle}" Background="#10B981" Height="40" Width="150" Margin="6,0" />
                                        <Button x:Name="TtTeckRegistrationElectronicPrescriptionButton" Content="نسخه‌محور" Click="TtTeckRegistrationElectronicPrescriptionButton_Click" Style="{StaticResource RoundedButtonStyle}" Background="#9CA3AF" Height="40" Width="150" Margin="6,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="TtTeckRegistrationTypeComboBox" SelectionChanged="TtTeckRegistrationTypeComboBox_SelectionChanged" Visibility="Collapsed">
                                        <ComboBoxItem x:Name="TtTeckRegistrationNonePrescriptionItem" Content="فاقد نسخه" IsSelected="True" />
                                        <ComboBoxItem x:Name="TtTeckRegistrationElectronicPrescriptionItem" Content="نسخه‌محور" />
                                    </ComboBox>

                                    <TextBlock x:Name="TtTeckRegistrationAmountLabel" Text="تعداد" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5" TextAlignment="Center" />
                                    <TextBox x:Name="TtTeckRegistrationAmountTextBox" Style="{StaticResource RoundedInputStyle}" Text="1" IsReadOnly="True" Background="#F1F5F9" Width="420" Height="42" FontSize="18" Padding="12,7" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckRegistrationAmountTextBox_KeyDown" Margin="0,0,0,10" ToolTip="تعداد همیشه ۱ است تا اسکنِ گوشی به‌اشتباه در این فیلد ثبت نشود؛ برای تعداد بیشتر، همان کالا را چند بار اسکن کنید." />

                                    <TextBlock x:Name="TtTeckRegistrationNationalIdLabel" Text="کد ملی بیمار" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5" TextAlignment="Center" />
                                    <TextBox x:Name="TtTeckRegistrationNationalIdTextBox" Style="{StaticResource RoundedInputStyle}" Width="420" Height="48" FontSize="24" Padding="12,8" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckRegistrationNationalIdTextBox_KeyDown" Margin="0,0,0,10" />

                                    <TextBlock x:Name="TtTeckRegistrationBirthDateLabel" Text="تاریخ تولد بیمار (شمسی)" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5" TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                        <TextBox x:Name="TtTeckBirthDayTextBox" GotFocus="TtTeckBirthDateBox_GotFocus" Style="{StaticResource RoundedInputStyle}" Width="132" Height="42" FontSize="18" Padding="12,7" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckBirthDayTextBox_KeyDown" ToolTip="روز" />
                                        <TextBox x:Name="TtTeckBirthMonthTextBox" GotFocus="TtTeckBirthDateBox_GotFocus" Style="{StaticResource RoundedInputStyle}" Width="132" Height="42" FontSize="18" Padding="12,7" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckBirthMonthTextBox_KeyDown" ToolTip="ماه" Margin="12,0" />
                                        <TextBox x:Name="TtTeckBirthYearTextBox" GotFocus="TtTeckBirthDateBox_GotFocus" Style="{StaticResource RoundedInputStyle}" Width="132" Height="42" FontSize="18" Padding="12,7" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckBirthYearTextBox_KeyDown" ToolTip="سال" />
                                    </StackPanel>
                                    <TextBlock x:Name="TtTeckRegistrationBirthDateHint" Text="روز / ماه / سال  - مثال: 20 / 6 / 1379" FontSize="12" Foreground="#6B7280" TextAlignment="Center" Margin="0,0,0,10" />
                                    <ComboBox x:Name="TtTeckBirthYearComboBox" Visibility="Collapsed" />
                                    <ComboBox x:Name="TtTeckBirthMonthComboBox" Visibility="Collapsed" />
                                    <ComboBox x:Name="TtTeckBirthDayComboBox" Visibility="Collapsed" />
                                    <TextBox x:Name="TtTeckRegistrationBirthDateTextBox" Visibility="Collapsed" />

                                    <StackPanel x:Name="TtTeckRegistrationMedicalCouncilPanel" Visibility="Collapsed">
                                        <TextBlock x:Name="TtTeckRegistrationMedicalCouncilLabel" Text="شماره نظام پزشکی" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5" TextAlignment="Center" />
                                        <TextBox x:Name="TtTeckRegistrationMedicalCouncilTextBox" Style="{StaticResource RoundedInputStyle}" Width="420" Height="42" FontSize="18" Padding="12,7" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckRegistrationMedicalCouncilTextBox_KeyDown" Margin="0,0,0,10" />
                                        <TextBlock x:Name="TtTeckRegistrationMedicalCouncilHint" Text="برای نسخه‌محور الزامی است؛ برنامه آن را به صورت MD_شماره ارسال می‌کند." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                                    </StackPanel>

                                    <TextBlock x:Name="TtTeckRegistrationMobileLabel" Text="شماره همراه بیمار / مراجعه‌کننده (اختیاری)" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5" TextAlignment="Center" />
                                    <TextBox x:Name="TtTeckRegistrationMobileTextBox" Style="{StaticResource RoundedInputStyle}" Width="420" Height="42" FontSize="18" Padding="12,7" TextAlignment="Center" TextChanged="TtacRegistrationField_TextChanged" KeyDown="TtTeckRegistrationMobileTextBox_KeyDown" />
                                </StackPanel>
                            </Border>

